# Copy to `.env.docker` (gitignored) and fill in real values.
# Used ONLY by `docker compose` — local `bun dev` keeps using `.env.local`.
#
#   cp .env.docker.example .env.docker
#
# Tip: copy most secrets from `.env.local`, then change REDIS_URL to Redis Cloud.

NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Same Atlas cluster as local is fine
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/video-generator?appName=Cluster0

# Redis Cloud (TLS is auto-enabled for *.redis.io). Prefer rediss:// when the
# provider gives it; redis:// + auto-TLS also works for Redis Cloud.
# Redis Cloud certs often fail Node hostname checks — we skip SAN verify for
# *.redis.io (connection is still encrypted). Set REDIS_TLS=false to force plain.
REDIS_URL=redis://default:YOUR_REDIS_CLOUD_PASSWORD@YOUR_HOST.db.redis.io:15915
QUEUE_CONCURRENCY=2

AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
CLOUDFRONT_URL=

OPENROUTER_API_KEY=
ELEVEN_LABS_API_KEY=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CONNECT_CLIENT_ID=
YOUTUBE_CONNECT_CLIENT_SECRET=
YOUTUBE_CONNECT_REDIRECT_URI=http://localhost:3000/api/youtube/connect/callback
YOUTUBE_DATA_API_KEY=
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_TOKEN_ENCRYPTION_KEY=
AUTO_PUBLISH_YOUTUBE=false
