# Copy to `.env.local` and fill in real values.
# Bun loads `.env.local` automatically in development.
#
# Docker / prod uses a separate file: copy `.env.docker.example` → `.env.docker`
# and set REDIS_URL to Redis Cloud. Local `bun dev` is unaffected.

# =============================================================================
# Server
# =============================================================================
PORT=3000
HOST=localhost
NODE_ENV=development

# =============================================================================
# Database & queue (required)
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/video-generator
# Local: leave as localhost. Docker/prod: set Redis Cloud URI in `.env.docker` instead.
REDIS_URL=redis://localhost:6379
QUEUE_CONCURRENCY=2

# =============================================================================
# AWS S3 (required)
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
S3_BUCKET=your-s3-bucket-name

# Optional CloudFront CDN in front of the public bucket (gameplay + assets).
# Leave empty to fall back to direct S3 URLs.
CLOUDFRONT_URL=https://your-distribution.cloudfront.net

# =============================================================================
# AI services (required)
# =============================================================================

# OpenRouter — LLM script generation, image gen, and bulk TTS via AI SDK.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ElevenLabs — character voice cloning / premium voice generation.
# https://elevenlabs.io/app/settings/api-keys
ELEVEN_LABS_API_KEY=your_elevenlabs_api_key

# =============================================================================
# Model tier & overrides (optional)
# =============================================================================
# Tier presets: cheap | value | premium (see src/config/models.ts)
MODEL_TIER=cheap

# Per-field overrides (take precedence over MODEL_TIER)
# LLM_MODEL=deepseek/deepseek-v4-flash
# IMAGE_MODEL=google/gemini-2.5-flash-image
# TTS_MODEL=hexgrad/kokoro-82m
# TTS_VOICE=am_michael
# TTS_FORMAT=mp3
# VIDEO_MODEL=bytedance/seedance-2.0-fast

# =============================================================================
# Reddit story sourcing (optional)
# =============================================================================
# Create a "script" app at https://www.reddit.com/prefs/apps
# Leave empty to use LLM-only story generation.
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=Mozilla/5.0 (compatible; VidTemplateGen/1.0)

# Default story mode for auto reels: llm | hybrid | verbatim
STORY_MODE=llm

# In-process story bank top-up (disable if running multiple server instances)
STORY_TOPUP_ENABLED=true
STORY_TOPUP_INTERVAL_MS=1800000
STORY_TOPUP_THRESHOLD=10
STORY_TOPUP_COUNT=15
STORY_TOPUP_MODE=llm

# =============================================================================
# YouTube publishing (optional)
# =============================================================================
# OAuth2 "Desktop app" client from Google Cloud Console.
# Run `bun scripts/youtube-authorize.ts` once to mint YOUTUBE_REFRESH_TOKEN.
YOUTUBE_CLIENT_ID=your_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
# Optional separate Web OAuth client used by the frontend Add YouTube Channel flow.
YOUTUBE_CONNECT_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
YOUTUBE_CONNECT_CLIENT_SECRET=your_web_client_secret
YOUTUBE_CONNECT_REDIRECT_URI=http://localhost:3000/api/youtube/connect/callback
# 32+ random chars recommended. Used to encrypt frontend-connected channel refresh tokens in MongoDB.
YOUTUBE_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_secret
# Optional multi-channel publish targets. Each refresh token must be minted by
# running `bun scripts/youtube-authorize.ts` while signed into that channel's
# Google account. If set, the frontend publish panel will show these choices.
# YOUTUBE_CHANNELS_JSON=[{"id":"horror","label":"Horror Channel","refreshToken":"refresh_token_for_horror","privacyStatus":"public","categoryId":"24","niches":["horror","horror_comic"]},{"id":"reddit","label":"Reddit Stories","refreshToken":"refresh_token_for_reddit","privacyStatus":"public","categoryId":"22","niches":["reddit"]}]
YOUTUBE_REDIRECT_URI=http://localhost:53682/oauth2callback
YOUTUBE_CATEGORY_ID=22
YOUTUBE_PRIVACY_STATUS=private
AUTO_PUBLISH_YOUTUBE=false

# =============================================================================
# Threads publishing (optional)
# Add the "Access the Threads API" use case to the same Meta app as Instagram.
# These are the Threads-specific App ID/secret shown in that use case—not an
# Instagram access token. The redirect URL must exactly match Meta's setting.
# =============================================================================
THREADS_ENABLED=false
THREADS_APP_ID=your_threads_app_id
THREADS_APP_SECRET=your_threads_app_secret
THREADS_REDIRECT_URI=http://localhost:3000/api/threads/connect/callback
# Optional own-post "Part N" reply after a successful Threads publish.
THREADS_AUTO_FIRST_REPLY=false

# =============================================================================
# YouTube trend scout (optional)
# =============================================================================
# Plain API key for read-only YouTube Data API v3 (search / videos.list).
# Separate from OAuth publish credentials above.
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key
TREND_SCOUT_ENABLED=true

# =============================================================================
# Local processing paths (optional)
# Paths are resolved to absolute at startup (cwd-independent).
# On Windows, if ffmpeg is not on PATH, set full paths, e.g.:
#   FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
#   FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
# Caption fonts: Docker downloads them at image build. For local bun dev,
# run `bun run fetch-fonts` once (optional but recommended).
# =============================================================================
STORAGE_PATH=./storage
PROCESSING_PATH=./storage/processing
GAMEPLAY_DIR=./storage/gameplay
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Final encode speed (caption burn / mix / FX). veryfast is fine for Shorts;
# use medium only if you need slightly smaller files and have spare CPU.
FFMPEG_PRESET=veryfast

# =============================================================================
# Limits & tuning (optional)
# =============================================================================
MAX_FILE_SIZE_MB=2048
MAX_VIDEO_DURATION=300

SUBTITLE_PRIMARY_COLOR=#FFFFFF
SUBTITLE_SECONDARY_COLOR=#00FF00
CHUNK_SPEED_MULTIPLIER=0.75

REDDIT_NARRATION_TEMPO=1.12
REDDIT_SENTENCE_GAP_SECONDS=0.12
REDDIT_TITLE_GAP_SECONDS=0.2
